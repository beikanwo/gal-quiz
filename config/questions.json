  },

  "scoring": {
    "childTagFactor": 0.7,
    "_childTagFactor": "口味打分时，子标签分数打这个折扣再和父标签取最大；H 类（ero）子标签不算。雷点和硬条件不打折。",
    "hotTopVotesPct": 5,
    "defaultVotesAlpha": 0.15,
    "_votesAlpha": "人气系数 = (投票数 ÷ 可推荐作品的投票中位数)^votesAlpha。口味分打平时把公认的作品排前面。第 5 题没答时用 defaultVotesAlpha。",
    "hiddenGem": { "belowVotesPercentile": 50, "minRating": 75 },
    "quality": {"base":0.9,"span":0.1,"ratingFloor":65,"ratingRange":35},
    "_formula": "每题得分 = 加分部分 − 减分部分（落在 -1~1）。加分部分按「任一命中」：1 − Π(1 − 权重/该选项最大正权重 × 标签分数/3)；减分部分 = Σ(|权重| × 标签分数/3) ÷ 负权重绝对值之和；总分 = e^(matchSharpness × Σ 题目权重 × 每题得分) × 人气系数 × 质量系数 × 拔作降权。",
    "chineseReception": {"scoreFloor":7.2,"scoreCeiling":9,"maxBonus":0.8,"firstMinVotes":500,"hotVotes":2000,"bangumi":{"minVotes":100,"priorVotes":300,"maxBonus":0.7},"kungal":{"minVotes":20,"priorVotes":50,"maxBonus":0.1}},
    "matchSharpness": 2,
    "_matchSharpness": "总分里口味分的放大倍数：e^(matchSharpness × 口味分)。越大越偏向高匹配，抽取也越集中在前几名。",
    "minMatch": 0.15,
    "_minMatch": "答了口味题时，口味分低于这个值的作品排在所有达标作品后面（不够 poolSize 部时才会用到）。",
    "minReasonTagScore": 1,
    "poolSize": 15,
    "pickCount": 3
  }
}
