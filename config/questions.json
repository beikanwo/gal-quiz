  "playerTypes": {
    "_说明": "按第 6 题（通关感觉）的选项定玩家类型；跳过了就用 default。",
    "cry": { "name": "纸巾消耗大户", "desc": "就想被一部作品弄哭，哭完还想再来一次。" },
    "twist": { "name": "伏笔收集癖", "desc": "最爽的瞬间是真相揭开，回头一看全都对上了。" },
    "haunted": { "name": "后劲受害者", "desc": "喜欢通关好几天还走不出来的那种作品。" },
    "sweet": { "name": "糖分依赖症", "desc": "看角色们好好谈恋爱、好好过日子，就很满足。" },
    "hype": { "name": "热血魂", "desc": "要的是一路燃到最后的爽快感。" },
    "think": { "name": "想太多星人", "desc": "玩完一部 gal，还会盯着天花板想很久。" },
